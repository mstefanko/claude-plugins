.DS_Store
.swarm-do/worktrees/.DS_Store
deglaze/CLAUDE.md
deglaze/evals/results-*-smoke*/
# Raw stream-json traces: ~2MB per full run and they grow with every run. The rendered
# per-trial .md outputs, RESULTS.md, and NOTES.md are committed instead; re-run the harness
# if you need traces again.
deglaze/evals/results-*/*.jsonl
deglaze/evals/results-*/*.err
