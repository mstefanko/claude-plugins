#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: scripts/bakeoff-ensure-cli [--check] [--print-path]

Ensures a runnable Bakeoff CLI is available.

  --check       only check configured, provisioned, or packaged binaries; never build
  --print-path  print only the resolved executable path on success
EOF
}

check_only=0
print_path=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)
      check_only=1
      shift
      ;;
    --print-path|--path)
      print_path=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      echo "error: unknown flag: $1" >&2
      exit 2
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/bakeoff-lib"
root="$(bakeoff_plugin_root)"

report_probe() {
  local binary="$1"
  local label="$2"
  local version
  if ! version="$(bakeoff_version_probe "$binary" "$label")"; then
    return 1
  fi
  if [[ "$print_path" -eq 1 ]]; then
    printf '%s\n' "$binary"
  else
    echo "bakeoff cli: using $label ($binary): $version"
  fi
}

while IFS=$'\t' read -r label path kind; do
  if [[ "$kind" == "explicit" ]]; then
    if [[ ! -x "$path" ]]; then
      echo "error: BAKEOFF_GO_BINARY is set but is not executable: $path" >&2
      bakeoff_print_missing_cli_help
      exit 2
    fi
    report_probe "$path" "$label" || exit 1
    exit 0
  fi

  if [[ -e "$path" || -L "$path" ]]; then
    if [[ ! -x "$path" ]]; then
      echo "error: $label exists but is not executable: $path" >&2
      exit 2
    fi
    report_probe "$path" "$label" || exit 1
    exit 0
  fi
done < <(bakeoff_candidate_binaries)

if [[ "$check_only" -eq 1 ]]; then
  bakeoff_print_missing_cli_help
  exit 2
fi

if ! command -v go >/dev/null 2>&1; then
  bakeoff_print_missing_cli_help
  exit 2
fi

if ! mkdir -p "$root/dist"; then
  echo "error: failed to create $root/dist" >&2
  exit 1
fi

if ! (cd "$root" && GOCACHE="${GOCACHE:-$(bakeoff_default_go_cache)}" go build -o "$root/dist/bakeoff" ./cmd/bakeoff); then
  echo "error: failed to build Bakeoff CLI into $root/dist/bakeoff" >&2
  exit 1
fi

report_probe "$root/dist/bakeoff" "built dist/bakeoff" || exit 1
