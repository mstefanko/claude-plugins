#!/usr/bin/env bash

BAKEOFF_RELEASE_REPOSITORY_DEFAULT="mstefanko/claude-plugins"
BAKEOFF_SUPPORTED_SETUP_PLATFORMS="darwin/arm64 darwin/amd64 linux/arm64 linux/amd64"
BAKEOFF_WINDOWS_UNSUPPORTED_MESSAGE="Windows setup is unsupported in v1; use BAKEOFF_GO_BINARY, dist/bakeoff, or run from a source checkout until the Claude Code shell path is tested on Windows."
BAKEOFF_MACOS_GATEKEEPER_HELP="macOS may be blocking this unsigned Bakeoff binary. Prefer a signed/notarized release when available, use a source build, or manually remove quarantine only if you explicitly trust the downloaded binary."

BAKEOFF_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

bakeoff_strip_trailing_slashes() {
  local value="$1"
  while [[ "$value" != "/" && "$value" == */ ]]; do
    value="${value%/}"
  done
  printf '%s\n' "$value"
}

bakeoff_normalize_path_key() {
  local path dir base physical_dir
  path="$(bakeoff_strip_trailing_slashes "$1")"
  if [[ -z "$path" ]]; then
    printf '\n'
    return 0
  fi
  dir="$(dirname "$path")"
  base="$(basename "$path")"
  if [[ -d "$dir" ]]; then
    if physical_dir="$(cd "$dir" 2>/dev/null && pwd -P)"; then
      printf '%s/%s\n' "$physical_dir" "$base"
      return 0
    fi
  fi
  case "$path" in
    /*) printf '%s\n' "$path" ;;
    *) printf '%s/%s\n' "$(pwd -P)" "$path" ;;
  esac
}

bakeoff_plugin_root() {
  if [[ -n "${BAKEOFF_PLUGIN_ROOT:-}" ]]; then
    printf '%s\n' "$BAKEOFF_PLUGIN_ROOT"
    return 0
  fi
  if [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]]; then
    printf '%s\n' "$CLAUDE_PLUGIN_ROOT"
    return 0
  fi
  if [[ -n "${CODEX_PLUGIN_ROOT:-}" ]]; then
    printf '%s\n' "$CODEX_PLUGIN_ROOT"
    return 0
  fi
  cd "$BAKEOFF_LIB_DIR/.." && pwd
}

bakeoff_data_root() {
  if [[ -n "${BAKEOFF_PLUGIN_DATA:-}" ]]; then
    printf '%s\n' "$BAKEOFF_PLUGIN_DATA"
    return 0
  fi
  if [[ -n "${CLAUDE_PLUGIN_DATA:-}" ]]; then
    printf '%s\n' "$CLAUDE_PLUGIN_DATA"
    return 0
  fi
  return 1
}

bakeoff_plugin_coordinates() {
  local root prefix rest marketplace plugin version
  root="$(bakeoff_strip_trailing_slashes "$(bakeoff_plugin_root)")"

  case "$root" in
    */.claude/plugins/cache/*/*/*)
      prefix="${root%%/cache/*}"
      rest="${root#"$prefix/cache/"}"
      marketplace="${rest%%/*}"
      rest="${rest#*/}"
      plugin="${rest%%/*}"
      version="${rest#*/}"
      [[ -n "$version" && "$version" != */* ]] || return 1
      ;;
    */.claude/plugins/marketplaces/*/*)
      prefix="${root%%/marketplaces/*}"
      rest="${root#"$prefix/marketplaces/"}"
      marketplace="${rest%%/*}"
      rest="${rest#*/}"
      plugin="$rest"
      [[ "$plugin" != */* ]] || return 1
      ;;
    *)
      return 1
      ;;
  esac

  [[ -n "$prefix" && -n "$marketplace" && -n "$plugin" ]] || return 1
  printf '%s\t%s\t%s\n' "$prefix" "$marketplace" "$plugin"
}

bakeoff_conventional_data_root() {
  local prefix marketplace plugin
  IFS=$'\t' read -r prefix marketplace plugin < <(bakeoff_plugin_coordinates) || return 1
  printf '%s/data/%s-%s\n' "$prefix" "$plugin" "$marketplace"
}

bakeoff_conventional_cache_root() {
  local prefix marketplace plugin
  IFS=$'\t' read -r prefix marketplace plugin < <(bakeoff_plugin_coordinates) || return 1
  printf '%s/cache/%s/%s\n' "$prefix" "$marketplace" "$plugin"
}

bakeoff_default_go_cache() {
  local tmpdir
  tmpdir="$(bakeoff_strip_trailing_slashes "${TMPDIR:-/tmp}")"
  if [[ "$tmpdir" == "/" ]]; then
    printf '/bakeoff-go-cache\n'
  else
    printf '%s/bakeoff-go-cache\n' "$tmpdir"
  fi
}

bakeoff_host_os_arch() {
  local uname_s uname_m goos goarch
  uname_s="$(uname -s 2>/dev/null || printf unknown)"
  uname_m="$(uname -m 2>/dev/null || printf unknown)"

  case "$uname_s" in
    Darwin) goos="darwin" ;;
    Linux) goos="linux" ;;
    CYGWIN*|MINGW*|MSYS*|Windows_NT) goos="windows" ;;
    *) goos="$(printf '%s' "$uname_s" | tr '[:upper:]' '[:lower:]')" ;;
  esac

  case "$uname_m" in
    x86_64|amd64) goarch="amd64" ;;
    arm64|aarch64) goarch="arm64" ;;
    *) goarch="$uname_m" ;;
  esac

  printf '%s %s\n' "$goos" "$goarch"
}

bakeoff_candidate_binaries() {
  local data root data_label conventional_data
  local seen_paths=$'\n'

  candidate_seen() {
    local key="$1"
    [[ "$seen_paths" == *$'\n'"$key"$'\n'* ]]
  }

  emit_candidate() {
    local label="$1"
    local path="$2"
    local kind="$3"
    local key
    key="$(bakeoff_normalize_path_key "$path")"
    if candidate_seen "$key"; then
      return 0
    fi
    seen_paths+="$key"$'\n'
    printf '%s\t%s\t%s\n' "$label" "$path" "$kind"
  }

  if [[ -n "${BAKEOFF_GO_BINARY:-}" ]]; then
    emit_candidate 'BAKEOFF_GO_BINARY' "$BAKEOFF_GO_BINARY" 'explicit'
  fi

  if [[ -n "${BAKEOFF_PLUGIN_DATA:-}" ]]; then
    data="$(bakeoff_strip_trailing_slashes "$BAKEOFF_PLUGIN_DATA")"
    data_label="BAKEOFF_PLUGIN_DATA/bin/bakeoff"
    emit_candidate "$data_label" "$data/bin/bakeoff" 'provisioned'
  fi

  if [[ -n "${CLAUDE_PLUGIN_DATA:-}" ]]; then
    data="$(bakeoff_strip_trailing_slashes "$CLAUDE_PLUGIN_DATA")"
    data_label="CLAUDE_PLUGIN_DATA/bin/bakeoff"
    emit_candidate "$data_label" "$data/bin/bakeoff" 'provisioned'
  fi

  if conventional_data="$(bakeoff_conventional_data_root)"; then
    emit_candidate 'Claude plugin data/bin/bakeoff' "$conventional_data/bin/bakeoff" 'provisioned'
  fi

  root="$(bakeoff_strip_trailing_slashes "$(bakeoff_plugin_root)")"
  emit_candidate 'dist/bakeoff' "$root/dist/bakeoff" 'packaged'
}

bakeoff_version_probe() {
  local binary="$1"
  local label="$2"
  local version

  if ! version="$("$binary" --version 2>&1)"; then
    printf 'error: %s exists but failed version probe: %s\n' "$label" "$version" >&2
    return 1
  fi
  printf '%s\n' "$version"
}

bakeoff_print_missing_cli_help() {
  cat >&2 <<'EOF'
error: no provisioned Bakeoff CLI found.

Run /bakeoff:setup to build the bundled Bakeoff Go CLI into plugin data, or set
BAKEOFF_GO_BINARY to a trusted executable. The default setup path requires Go
1.24+ on this developer machine. Source checkouts can also run
scripts/bakeoff-ensure-cli without --check to build dist/bakeoff when Go is
available.
EOF
}
