{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "$id": "https://mstefanko-plugins/swarm-do/phase_result.schema.json#v1",
  "title": "swarm-do phase worker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "phase_id",
    "phase_attempt",
    "status",
    "launcher",
    "session_name",
    "prepared_plan_sha",
    "phase_content_sha",
    "started_at",
    "completed_at",
    "handoff_path",
    "summary",
    "completed_work_units",
    "failed_work_units",
    "blocked_reason",
    "needs_input",
    "validation",
    "artifacts",
    "error"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "phase_id": { "type": "string" },
    "phase_attempt": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["complete", "partial_success", "failed", "blocked", "needs_input"]
    },
    "launcher": { "type": "string" },
    "session_name": { "type": ["string", "null"] },
    "prepared_plan_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase_content_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "handoff_path": { "type": "string" },
    "summary": { "type": "string" },
    "completed_work_units": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failed_work_units": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocked_reason": { "type": ["string", "null"] },
    "needs_input": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation": {
      "type": "array",
      "items": { "type": "object" }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "error": { "type": ["object", "null"] },
    "worktree_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["committed", "staged", "unstaged", "untracked"],
      "properties": {
        "committed": { "type": "array", "items": { "type": "string" } },
        "staged": { "type": "array", "items": { "type": "string" } },
        "unstaged": { "type": "array", "items": { "type": "string" } },
        "untracked": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commit_sha": { "type": ["string", "null"] },
    "retryable": { "type": "boolean" },
    "failure_kind": { "type": "string" },
    "retry_after_seconds": { "type": ["integer", "null"], "minimum": 0 }
  }
}
