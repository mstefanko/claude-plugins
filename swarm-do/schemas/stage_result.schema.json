{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "$id": "https://mstefanko-plugins/swarm-do/stage_result.schema.json#v1",
  "title": "swarm-do phase stage result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "phase_id",
    "phase_attempt",
    "stage_id",
    "status",
    "summary",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "phase_id": { "type": "string" },
    "phase_attempt": { "type": "integer", "minimum": 1 },
    "stage_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["complete", "failed", "blocked", "needs_input"]
    },
    "summary": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
