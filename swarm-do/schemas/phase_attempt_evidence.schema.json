{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "$id": "https://mstefanko-plugins/swarm-do/phase_attempt_evidence.schema.json#v1",
  "title": "swarm-do phase attempt evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "phase_id",
    "attempt",
    "generated_at",
    "session_name",
    "launcher",
    "status",
    "paths",
    "hashes",
    "process",
    "workspace",
    "artifacts",
    "metrics",
    "failure",
    "recovery",
    "redaction"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "run_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "phase_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "session_name": { "type": ["string", "null"] },
    "launcher": { "type": ["string", "null"] },
    "status": { "type": "string" },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_dir",
        "evidence_path",
        "command_path",
        "prompt_path",
        "source_prompt_path",
        "stdout_path",
        "stderr_path",
        "result_path",
        "handoff_path"
      ],
      "properties": {
        "launch_dir": { "type": "string" },
        "evidence_path": { "type": "string" },
        "command_path": { "type": ["string", "null"] },
        "prompt_path": { "type": ["string", "null"] },
        "source_prompt_path": { "type": ["string", "null"] },
        "stdout_path": { "type": ["string", "null"] },
        "stderr_path": { "type": ["string", "null"] },
        "result_path": { "type": ["string", "null"] },
        "handoff_path": { "type": ["string", "null"] }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_sha", "source_prompt_sha", "settings_sha"],
      "properties": {
        "prompt_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "source_prompt_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "settings_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_pid",
        "child_pid",
        "process_group_id",
        "returncode",
        "started_at",
        "completed_at",
        "elapsed_seconds"
      ],
      "properties": {
        "parent_pid": { "type": ["integer", "null"], "minimum": 0 },
        "child_pid": { "type": ["integer", "null"], "minimum": 0 },
        "process_group_id": { "type": ["integer", "null"], "minimum": 0 },
        "returncode": { "type": ["integer", "null"] },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "elapsed_seconds": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_workspace_mode",
        "safe_cwd_enabled",
        "launcher_cwd",
        "launcher_repo_root",
        "real_repo_root_recorded"
      ],
      "properties": {
        "execution_workspace_mode": { "type": ["string", "null"] },
        "safe_cwd_enabled": { "type": ["boolean", "null"] },
        "launcher_cwd": { "type": ["string", "null"] },
        "launcher_repo_root": { "type": ["string", "null"] },
        "source_git_top_level": { "type": ["string", "null"] },
        "source_project_root": { "type": ["string", "null"] },
        "safe_git_worktree_root": { "type": ["string", "null"] },
        "safe_project_root": { "type": ["string", "null"] },
        "project_subdir": { "type": ["string", "null"] },
        "run_execution_branch": { "type": ["string", "null"] },
        "git_base_sha": { "type": ["string", "null"] },
        "run_worktree_manifest_path": { "type": ["string", "null"] },
        "real_repo_root_recorded": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_valid",
        "handoff_valid",
        "partial_artifacts",
        "artifact_error_kinds",
        "changed_files",
        "changed_file_count"
      ],
      "properties": {
        "result_valid": { "type": "boolean" },
        "handoff_valid": { "type": "boolean" },
        "partial_artifacts": { "type": "boolean" },
        "artifact_error_kinds": { "type": "array", "items": { "type": "string" } },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "changed_file_count": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cost_usd",
        "cost_confidence",
        "input_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "output_tokens",
        "duration_ms",
        "duration_api_ms",
        "num_turns",
        "permission_denial_count"
      ],
      "properties": {
        "total_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "cost_confidence": { "type": ["string", "null"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_creation_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "duration_api_ms": { "type": ["integer", "null"], "minimum": 0 },
        "num_turns": { "type": ["integer", "null"], "minimum": 0 },
        "permission_denial_count": { "type": "integer", "minimum": 0 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_kind",
        "failure_category",
        "failure_retry_class",
        "failure_operator_title",
        "failure_operator_message",
        "failure_known",
        "retry_decision",
        "retry_after_seconds",
        "blocked_reason",
        "diagnostic_last_error"
      ],
      "properties": {
        "failure_kind": { "type": ["string", "null"] },
        "failure_category": { "type": ["string", "null"] },
        "failure_retry_class": { "type": ["string", "null"] },
        "failure_operator_title": { "type": ["string", "null"] },
        "failure_operator_message": { "type": ["string", "null"] },
        "failure_known": { "type": "boolean" },
        "retry_decision": { "type": ["string", "null"] },
        "retry_after_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "blocked_reason": { "type": ["string", "null"] },
        "diagnostic_last_error": { "type": ["string", "null"] }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout_tail_path",
        "stderr_tail_path",
        "diff_summary_path",
        "recovery_context_path",
        "transcript_diagnostics_path",
        "transcript_found",
        "tool_errors_count"
      ],
      "properties": {
        "stdout_tail_path": { "type": ["string", "null"] },
        "stderr_tail_path": { "type": ["string", "null"] },
        "diff_summary_path": { "type": ["string", "null"] },
        "recovery_context_path": { "type": ["string", "null"] },
        "transcript_diagnostics_path": { "type": ["string", "null"] },
        "transcript_found": { "type": ["boolean", "null"] },
        "tool_errors_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_raw_prompt",
        "contains_raw_stdout",
        "contains_raw_stderr",
        "contains_raw_transcript",
        "contains_env",
        "path_values_may_be_local"
      ],
      "properties": {
        "contains_raw_prompt": { "type": "boolean" },
        "contains_raw_stdout": { "type": "boolean" },
        "contains_raw_stderr": { "type": "boolean" },
        "contains_raw_transcript": { "type": "boolean" },
        "contains_env": { "type": "boolean" },
        "path_values_may_be_local": { "type": "boolean" }
      }
    }
  }
}
