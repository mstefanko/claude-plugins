{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "$id": "https://mstefanko-plugins/swarm-do/phase_sessions.schema.json#v1",
  "title": "swarm-do phase-session queue state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "prepared_artifact_path",
    "prepared_plan_sha",
    "created_at",
    "updated_at",
    "mode",
    "lease_policy",
    "phases"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "prepared_artifact_path": { "type": "string" },
    "prepared_plan_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "enum": ["cli-pump"] },
    "lease_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ttl_seconds",
        "running_ttl_seconds",
        "refresh_interval_seconds"
      ],
      "properties": {
        "claim_ttl_seconds": { "type": "integer", "minimum": 1 },
        "running_ttl_seconds": { "type": "integer", "minimum": 1 },
        "refresh_interval_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_session_attempts": { "type": "integer", "minimum": 1 },
        "max_recovery_attempts": { "type": "integer", "minimum": 0 },
        "recovery_timeout_threshold_seconds": { "type": "integer", "minimum": 1 },
        "retry_sleep_threshold_seconds": { "type": "integer", "minimum": 0 },
        "short_retry_backoff_seconds": { "type": "integer", "minimum": 0 },
        "max_retry_after_seconds": { "type": "integer", "minimum": 0 },
        "max_consecutive_same_failure_kind": { "type": "integer", "minimum": 1 },
        "autopilot_profile": {
          "type": "string",
          "enum": ["standard", "dogfood", "strict"]
        },
        "max_failed_attempt_cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "max_failed_run_cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "max_phase_attempt_budget_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "worktree_baseline_path": { "type": ["string", "null"] },
        "worktree_baseline_warning": { "type": ["string", "null"] }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase_id",
          "phase_index",
          "title",
          "depends_on_phase_ids",
          "status",
          "lease_owner",
          "lease_host",
          "lease_pid",
          "lease_command",
          "lease_expires_at",
          "attempt",
          "session_name",
          "started_at",
          "completed_at",
          "result_path",
          "handoff_path",
          "last_error"
        ],
        "properties": {
          "phase_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "phase_index": { "type": "integer", "minimum": 0 },
          "title": { "type": "string" },
          "depends_on_phase_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "leased",
              "running",
              "complete",
              "failed",
              "blocked",
              "needs_input",
              "stale",
              "retry_waiting",
              "retry_exhausted"
            ]
          },
          "lease_owner": { "type": ["string", "null"] },
          "lease_host": { "type": ["string", "null"] },
          "lease_pid": { "type": ["integer", "null"], "minimum": 0 },
          "lease_command": { "type": ["string", "null"] },
          "lease_expires_at": { "type": ["string", "null"], "format": "date-time" },
          "attempt": { "type": "integer", "minimum": 0 },
          "session_name": { "type": ["string", "null"] },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "completed_at": { "type": ["string", "null"], "format": "date-time" },
          "result_path": { "type": ["string", "null"] },
          "handoff_path": { "type": ["string", "null"] },
          "last_error": { "type": ["string", "null"] },
          "max_session_attempts": { "type": ["integer", "null"], "minimum": 1 },
          "next_retry_at": { "type": ["string", "null"], "format": "date-time" },
          "last_failure_kind": { "type": ["string", "null"] },
          "last_launcher_error": { "type": ["string", "null"] },
          "retry_exhausted_at": { "type": ["string", "null"], "format": "date-time" },
          "blocked_reason": {
            "type": ["string", "null"],
            "enum": [
              "retry_policy_human_gate",
              "deterministic_contract_failure",
              "permission_contract_failure",
              "operator_cancelled",
              "child_reported_blocked",
              null
            ]
          },
          "retry_policy_decision": { "type": ["string", "null"] },
          "blocked_at": { "type": ["string", "null"], "format": "date-time" },
          "launch_dir": { "type": ["string", "null"] },
          "command_path": { "type": ["string", "null"] },
          "parent_pid": { "type": ["integer", "null"], "minimum": 0 },
          "child_pid": { "type": ["integer", "null"], "minimum": 0 },
          "process_group_id": { "type": ["integer", "null"], "minimum": 0 },
          "prompt_sha": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_result_path": { "type": ["string", "null"] },
          "expected_handoff_path": { "type": ["string", "null"] },
          "launch_metadata_error": { "type": ["string", "null"] },
          "recovery_context_path": { "type": ["string", "null"] },
          "evidence_path": { "type": ["string", "null"] },
          "attempt_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "attempt": { "type": "integer", "minimum": 1 },
                "session_name": { "type": ["string", "null"] },
                "launcher": { "type": ["string", "null"] },
                "lease_owner": { "type": ["string", "null"] },
                "lease_host": { "type": ["string", "null"] },
                "lease_pid": { "type": ["integer", "null"], "minimum": 0 },
                "child_pid": { "type": ["integer", "null"], "minimum": 0 },
                "process_group_id": { "type": ["integer", "null"], "minimum": 0 },
                "started_at": { "type": ["string", "null"], "format": "date-time" },
                "completed_at": { "type": ["string", "null"], "format": "date-time" },
                "elapsed_seconds": { "type": ["number", "null"], "minimum": 0 },
                "launch_dir": { "type": ["string", "null"] },
                "result_path": { "type": ["string", "null"] },
                "handoff_path": { "type": ["string", "null"] },
                "returncode": { "type": ["integer", "null"] },
                "failure_kind": { "type": ["string", "null"] },
                "failure_category": { "type": ["string", "null"] },
                "failure_retry_class": { "type": ["string", "null"] },
                "failure_operator_title": { "type": ["string", "null"] },
                "failure_operator_message": { "type": ["string", "null"] },
                "failure_known": { "type": ["boolean", "null"] },
                "retry_decision": { "type": ["string", "null"] },
                "operator_decision_id": { "type": ["string", "null"] },
                "operator_decision_kind": { "type": ["string", "null"] },
                "operator": { "type": ["string", "null"] },
                "operator_reason": { "type": ["string", "null"] },
                "retry_after_seconds": { "type": ["integer", "null"], "minimum": 0 },
                "policy_action": {
                  "type": ["string", "null"],
                  "enum": [
                    "retry",
                    "retry_after_backoff",
                    "recovery_retry",
                    "human_gate",
                    "retry_exhausted",
                    "terminal",
                    null
                  ]
                },
                "policy_reason": {
                  "type": ["string", "null"],
                  "enum": [
                    "taxonomy_human_gate",
                    "deterministic_contract_failure",
                    "permission_contract_failure",
                    "same_failure_limit",
                    "retry_budget_exhausted",
                    "recovery_retry_budget_exhausted",
                    "failed_attempt_spend_threshold",
                    "failed_run_spend_threshold",
                    "child_do_not_retry",
                    "child_nonretryable_failed",
                    "retry_after_requested",
                    "normal_retry",
                    "recovery_retry_required",
                    null
                  ]
                },
                "policy_inputs": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "properties": {
                    "failure_kind": { "type": ["string", "null"] },
                    "failure_category": { "type": ["string", "null"] },
                    "failure_retry_class": { "type": ["string", "null"] },
                    "attempt": { "type": ["integer", "null"], "minimum": 1 },
                    "same_failure_count": { "type": ["integer", "null"], "minimum": 0 },
                    "max_session_attempts": { "type": ["integer", "null"], "minimum": 1 },
                    "max_recovery_attempts": { "type": ["integer", "null"], "minimum": 0 },
                    "max_consecutive_same_failure_kind": { "type": ["integer", "null"], "minimum": 1 },
                    "recovery_attempts_used": { "type": ["integer", "null"], "minimum": 0 },
                    "needs_recovery_retry": { "type": ["boolean", "null"] },
                    "recovery_timeout_threshold_seconds": { "type": ["integer", "null"], "minimum": 1 },
                    "retry_sleep_threshold_seconds": { "type": ["integer", "null"], "minimum": 0 },
                    "short_retry_backoff_seconds": { "type": ["integer", "null"], "minimum": 0 },
                    "max_retry_after_seconds": { "type": ["integer", "null"], "minimum": 0 },
                    "returncode": { "type": ["integer", "null"] },
                    "artifact_error_kinds": { "type": "array", "items": { "type": "string" } },
                    "partial_artifacts": { "type": ["boolean", "null"] },
                    "changed_file_count": { "type": ["integer", "null"], "minimum": 0 },
                    "elapsed_seconds": { "type": ["number", "null"], "minimum": 0 },
                    "retry_after_seconds_requested": { "type": ["integer", "null"], "minimum": 0 },
                    "current_attempt_cost_usd": { "type": ["number", "null"], "minimum": 0 },
                    "failed_phase_cost_usd": { "type": ["number", "null"], "minimum": 0 },
                    "failed_run_cost_usd": { "type": ["number", "null"], "minimum": 0 },
                    "unknown_failed_attempt_count": { "type": ["integer", "null"], "minimum": 0 },
                    "cost_confidence": {
                      "type": ["string", "null"],
                      "enum": ["provider_reported", "unknown", "conflict", null]
                    },
                    "max_failed_attempt_cost_usd": { "type": ["number", "null"], "minimum": 0 },
                    "max_failed_run_cost_usd": { "type": ["number", "null"], "minimum": 0 },
                    "max_phase_attempt_budget_usd": { "type": ["number", "null"], "minimum": 0 },
                    "handoff_do_not_retry": { "type": ["boolean", "null"] }
                  }
                },
                "adopted": { "type": "boolean" },
                "partial_artifacts": { "type": "boolean" },
                "artifact_error_kinds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "stdout_tail_path": { "type": ["string", "null"] },
                "stderr_tail_path": { "type": ["string", "null"] },
                "changed_files": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "child_process": {
                  "type": "object",
                  "additionalProperties": true
                },
                "cleanup": {
                  "type": "object",
                  "additionalProperties": true
                },
                "evidence_path": { "type": ["string", "null"] },
                "diff_summary_path": { "type": ["string", "null"] },
                "recovery_context_path": { "type": ["string", "null"] },
                "transcript_diagnostics_path": { "type": ["string", "null"] },
                "transcript_found": { "type": ["boolean", "null"] },
                "transcript_path": { "type": ["string", "null"] },
                "tool_errors_count": { "type": ["integer", "null"], "minimum": 0 },
                "diagnostic_last_error": { "type": ["string", "null"] },
                "tool_name": { "type": ["string", "null"] },
                "tool_error_kind": { "type": ["string", "null"] },
                "message_excerpt": { "type": ["string", "null"] },
                "sensitive_path_excerpt": { "type": ["string", "null"] },
                "command_metadata": {
                  "type": "object",
                  "additionalProperties": true
                },
                "execution_workspace_mode": { "type": ["string", "null"] },
                "source_git_top_level": { "type": ["string", "null"] },
                "source_project_root": { "type": ["string", "null"] },
                "safe_git_worktree_root": { "type": ["string", "null"] },
                "safe_project_root": { "type": ["string", "null"] },
                "project_subdir": { "type": ["string", "null"] },
                "run_execution_branch": { "type": ["string", "null"] },
                "git_base_sha": { "type": ["string", "null"] },
                "git_base_ref": { "type": ["string", "null"] },
                "run_worktree_manifest_path": { "type": ["string", "null"] },
                "copied_ignored_artifacts": {
                  "type": "array",
                  "items": { "type": "object", "additionalProperties": true }
                }
              }
            }
          }
        }
      }
    }
  }
}
