{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "$id": "https://mstefanko-plugins/swarm-do/telemetry/run_events.schema.json#v1",
  "title": "swarm-do run event record",
  "description": "Companion ledger for orchestration events that must not mutate frozen runs.v1 rows.",
  "type": "object",
  "required": [
    "run_id",
    "timestamp",
    "event_type",
    "schema_ok"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "checkpoint_written",
        "resume_started",
        "resume_completed",
        "drift_detected",
        "handoff_triggered",
        "handoff_reason",
        "retry_started",
        "retry_exhausted",
        "worktree_merge_conflict",
        "prepare_started",
        "prepare_lint_findings",
        "prepare_review_findings",
        "prepare_safe_fixes_accepted",
        "prepare_safe_fixes_proposed_unaccepted",
        "prepare_ready_for_acceptance",
        "prepare_blocking_findings",
        "prepare_accepted",
        "prepare_stale_rejected",
        "prepare_continue_failed",
        "prepare_continue_decision",
        "prepare_contract_snapshot",
        "prepare_dispatch_started",
        "prepared_dispatch_refreshed",
        "run_preflight_completed",
        "phase_session_initialized",
        "phase_session_claimed",
        "phase_session_started",
        "phase_session_refreshed",
        "phase_session_active_preserved",
        "phase_session_completed",
        "phase_session_failed",
        "phase_session_blocked",
        "phase_session_needs_input",
        "phase_session_lease_expired",
        "phase_session_reconciled",
        "phase_session_reset",
        "phase_attempt_abandoned",
        "phase_attempt_retry_scheduled",
        "phase_attempt_retry_ready",
        "phase_attempt_retry_exhausted",
        "phase_attempt_adopted",
        "phase_attempt_evidence_failed",
        "phase_beads_note_failed",
        "operator_decision_recorded",
        "operator_decision_applied",
        "operator_decision_apply_noop",
        "operator_decisions_retention_warning",
        "phase_result_recorded",
        "phase_handoff_recorded",
        "phase_context_rendered",
        "stage_adopted",
        "phase_pump_started",
        "phase_pump_stopped",
        "phase_pump_launcher_ineligible",
        "worktree_rebuilt",
        "worktree_reset",
        "post_writer_report",
        "dogfood_check"
      ]
    },
    "bd_epic_id": {
      "type": ["string", "null"]
    },
    "phase_id": {
      "type": ["string", "null"]
    },
    "work_unit_id": {
      "type": ["string", "null"]
    },
    "child_bead_ids": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "reason": {
      "type": ["string", "null"]
    },
    "retry_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "handoff_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "integration_branch_head": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "details": {
      "type": ["object", "null"]
    },
    "schema_ok": {
      "type": "boolean"
    }
  }
}
