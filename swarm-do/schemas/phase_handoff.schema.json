{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "$id": "https://mstefanko-plugins/swarm-do/phase_handoff.schema.json#v1",
  "title": "swarm-do phase handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "phase_id",
    "phase_attempt",
    "status",
    "written_at",
    "summary",
    "decisions",
    "changed_files",
    "completed_work_units",
    "open_items",
    "blockers",
    "do_not_retry",
    "validation_summary",
    "artifacts",
    "next_phase_context"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "phase_id": { "type": "string" },
    "phase_attempt": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["complete", "failed", "blocked", "needs_input"]
    },
    "written_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" },
    "decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "completed_work_units": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "do_not_retry": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation_summary": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "next_phase_context": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
